{
  "actorSpecification": 1,
  "name": "blinkit-quick-commerce-scraper",
  "title": "Blinkit Product Scraper - $1.5/1k, Prices & Stock by Location",
  "description": "Scrape public Blinkit product listings by keyword and delivery location: prices, MRP, discounts, pack sizes, stock, ratings, images, and URLs. $1.50 per 1,000 products, no run-start fee, no login.",
  "version": "1.0",
  "buildTag": "latest",
  "dockerfile": "Dockerfile",
  "input": "../INPUT_SCHEMA.json",
  "readme": "../README.md",
  "exampleRunInput": {
    "body": "{\"searchQueries\":[\"milk\"],\"locationName\":\"Mumbai\",\"latitude\":19.076,\"longitude\":72.8777,\"brands\":[],\"inStockOnly\":true,\"minPrice\":0,\"maxPrice\":1000000,\"maxResults\":50,\"maxPagesPerQuery\":5,\"proxyConfiguration\":{\"useApifyProxy\":true,\"apifyProxyGroups\":[\"RESIDENTIAL\"],\"apifyProxyCountry\":\"IN\"}}",
    "contentType": "application/json; charset=utf-8"
  },
  "output": "./output_schema.json",
  "categories": ["ECOMMERCE", "AUTOMATION"],
  "categoriesVersion": "1.0.0",
  "pricingInfo": {
    "pricingModel": "PAY_PER_EVENT",
    "pricingPerEvent": {
      "actorChargeEvents": {
        "apify-actor-start": {
          "eventTitle": "Actor Start",
          "eventDescription": "Charged when the Actor starts running. Number of events charged depends on Actor memory (one event per GB, minimum one event).",
          "eventPriceUsd": 0.00005,
          "isPrimaryEvent": false,
          "isOneTimeEvent": true
        },
        "product-scraped": {
          "eventTitle": "Product scraped",
          "eventDescription": "Charged once for each clean Blinkit product saved to the dataset.",
          "eventPriceUsd": 0.0015,
          "isPrimaryEvent": true,
          "isOneTimeEvent": false
        }
      }
    }
  },
  "storages": {
    "dataset": "./dataset_schema.json"
  },
  "defaultRunOptions": {
    "build": "latest",
    "memoryMbytes": 512,
    "timeoutSecs": 900
  },
  "minMemoryMbytes": 256,
  "maxMemoryMbytes": 2048
}
